{$DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }
  reverse_proxy api:3000 {
    header_up X-Forwarded-For {remote_host}
    transport http {
      response_header_timeout 25s
    }
  }
}
