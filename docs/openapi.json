{
  "openapi": "3.0.3",
  "info": {
    "title": "Kaminsky Weather API",
    "version": "1.0.0",
    "description": "CRUD de estações e consulta do card WeatherLink. Cache de 15 minutos sob demanda, sem coleta agendada nem histórico. Dados com mais de 2 horas retornam data:null. Autenticação por X-API-Key nas rotas de estações. Use HTTPS fora do computador local. A fonte é uma rota interna não documentada e pode mudar. Leitura e administração usam chaves distintas no cabeçalho X-API-Key."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor atual"
    }
  ],
  "tags": [
    {
      "name": "Sistema"
    },
    {
      "name": "Estações"
    },
    {
      "name": "Dados"
    }
  ],
