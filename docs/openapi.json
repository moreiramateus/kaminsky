  "components": {
    "schemas": {
      "Erro": {
        "type": "object",
        "required": [
          "erro"
        ],
        "properties": {
          "erro": {
            "type": "string"
          }
        }
      },
      "CadastroEntrada": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "weatherlink_id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://www.weatherlink.com/map/0b4bc246-d54a-47a7-8abf-cbe8ad2d882b"
          },
          "habilitada": {
            "type": "boolean",
            "default": true
          }
        },
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "weatherlink_id"
            ]
          }
        ]
      },
      "EdicaoEntrada": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "weatherlink_id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://www.weatherlink.com/map/0b4bc246-d54a-47a7-8abf-cbe8ad2d882b"
          },
          "habilitada": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "Estacao": {
        "type": "object",
        "required": [
          "id",
          "weatherlink_id",
          "nome",
          "habilitada",
          "criado_em",
          "atualizado_em"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "weatherlink_id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "habilitada": {
            "type": "boolean"
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DadosNormalizados": {
        "type": "object",
        "nullable": true,
        "properties": {
          "temperatura_c": {
            "type": "number",
            "nullable": true
          },
          "umidade_pct": {
            "type": "number",
            "nullable": true
          },
          "chuva_dia_mm": {
            "type": "number",
            "nullable": true
          },
          "vento_ms": {
            "type": "number",
            "nullable": true
          },
          "vento_direcao_graus": {
            "type": "number",
            "nullable": true
          },
          "pressao_hpa": {
            "type": "number",
            "nullable": true
          },
